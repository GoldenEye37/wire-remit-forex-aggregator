// Grafana Alloy Configuration for WireRemit Forex Aggregator
// Collects logs from Docker containers and sends to Loki

// Discover all Docker containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

// Relabel Docker metadata to useful labels
discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  // Extract container name
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
    regex         = "/(.*)"
    replacement   = "$1"
  }

  // Extract container ID
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  // Extract image name
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  // Extract service label if present
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Extract project label if present
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  // Set job label
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "job"
    regex         = "/(.*)"
    replacement   = "$1"
  }
}

// Collect logs from Docker containers
loki.source.docker "docker_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker.output
  forward_to       = [loki.process.parse_json.receiver]
  refresh_interval = "5s"

  // Relabel rules for log labels
  relabel_rules = discovery.relabel.docker.rules
}

// Process and parse JSON logs
loki.process "parse_json" {
  // Parse loguru's serialized JSON structure
  // Structure: {"text": "...", "record": {"level": {"name": "INFO"}, "extra": {...}}}
  stage.json {
    expressions = {
      // Extract from record.level.name
      level       = "record.level.name",
      // Extract from record object
      logger      = "record.name",
      message     = "record.message",
      function    = "record.function",
      line        = "record.line",
      // Extract from record.extra
      trace_id    = "record.extra.trace_id",
      span_id     = "record.extra.span_id",
      request_id  = "record.extra.request_id",
      operation   = "record.extra.operation",
      user_id     = "record.extra.user_id",
      http_method = "record.extra.http_method",
      http_path   = "record.extra.http_path",
      http_status = "record.extra.http_status",
      duration_ms = "record.extra.duration_ms",
      error_type  = "record.extra.error_type",
      provider    = "record.extra.provider",
    }
  }

  // Extract level as a label (for efficient filtering)
  stage.labels {
    values = {
      level = "",
    }
  }

  // Add extracted fields as labels for indexing
  stage.labels {
    values = {
      logger    = "",
      operation = "",
    }
  }

  // Output structured metadata (not indexed, but searchable)
  stage.structured_metadata {
    values = {
      trace_id    = "",
      span_id     = "",
      request_id  = "",
      user_id     = "",
      http_method = "",
      http_path   = "",
      http_status = "",
      duration_ms = "",
      error_type  = "",
      provider    = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// Write logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"

    // Optional: Add tenant ID header for multi-tenancy
    headers = {
      "X-Scope-OrgID" = "forex-aggregator",
    }
  }

  // External labels (applied to all logs)
  external_labels = {
    cluster = "local",
    environment = "development",
  }
}
